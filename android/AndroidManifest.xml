<?xml version="1.0" encoding="utf-8"?>
<!--
  EZ Sign Writer: writes EZ Sign Studio payloads to a Santek EZ Sign over NFC.
  Deliberately requests only NFC. No INTERNET, no storage, no other permissions:
  files arrive through Android's share sheet or the system file picker, which grant
  one-time read access to that single file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.shesk.ezsign">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="37" />

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:label="EZ Sign Writer"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- From EZ Sign Studio's "Send to sign" (Chrome only shares .txt-typed files) -->
            <intent-filter android:label="Write to EZ Sign">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Write to EZ Sign">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Opening a saved .ezs from the Files app -->
            <intent-filter android:label="Write to EZ Sign">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
